FROM golang:1.24.0-bullseye AS builder

# Install build dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    pkg-config \
    curl \
    tar \
    && rm -rf /var/lib/apt/lists/*

# Set up working directory
WORKDIR /app

RUN mkdir -p /app/lib

# Download and extract tokenizers
RUN curl -L https://github.com/daulet/tokenizers/releases/download/v1.20.2/libtokenizers.linux-arm64.tar.gz -o /tmp/libtokenizers.tar.gz && \
    tar -xzf /tmp/libtokenizers.tar.gz -C /app/lib


# Download and extract onnxruntime
RUN curl -L https://github.com/microsoft/onnxruntime/releases/download/v1.20.1/onnxruntime-linux-aarch64-1.20.1.tgz \
    -o /tmp/onnxruntime-linux-aarch64-1.20.1.tgz && \
    tar -xzvf /tmp/onnxruntime-linux-aarch64-1.20.1.tgz \
    --transform 's/onnxruntime-linux-aarch64-1.20.1/onnxruntime/' && \
    cp onnxruntime/lib/libonnxruntime.so.1.20.1 /app/lib/libonnxruntime.so

RUN rm -r /tmp/*

# Copy go mod and go sum files
COPY go.mod go.sum ./

# Set environment variables for CGO
ENV CGO_ENABLED=1
ENV CGO_LDFLAGS="-L/app/lib -ltokenizers"

# Download dependencies
RUN go mod download

# Copy the entire codebase
COPY . .

# Build the application
RUN go build -o semantic-search-system ./cmd/main.go

# Create runtime image
FROM --platform=linux/arm64 ubuntu:24.04

# Install runtime dependencies (lightened)
RUN apt-get update && apt-get install -y \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Set up working directory
WORKDIR /app

# Create folder structure for models
RUN mkdir -p /app/lib/models

# Copy binary from builder stage
COPY --from=builder /app/semantic-search-system /app/

# Copy required libraries
COPY --from=builder /app/lib/ /app/lib/

# Create symbolic link for onnxruntime.so if needed
RUN ln -sf /app/lib/libonnxruntime.so /app/lib/onnxruntime.so

# Set up library path
ENV LD_LIBRARY_PATH=/app/lib

# Grant execute permission
RUN chmod +x /app/semantic-search-system

# Expose port 3000
EXPOSE 3000

# Run the application
CMD ["/app/semantic-search-system"]